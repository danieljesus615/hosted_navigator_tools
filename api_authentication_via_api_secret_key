####################################################################################################
###################### BUILD AUTHENTICATION HEADER #################################################
####################################################################################################

def get_api_hearder(navigator_instance, url_path, api_call_type):

    sr = rsign.SignedRequest(api_call_type, navigator_instance, url_path, '443')
    timestamp = str(int(time.time()))

    nonce = binascii.b2a_base64(os.urandom(32)).decode().strip()
    headers = sr.get_signed_header(nonce, timestamp, api_key_id, api_key_secret)

    # The Authorization header must be provided as a string value.
    #
    # Example format:
    # header = {
    #     'Authorization':
    #     'MAC id="string", ts="string", nonce="string", mac="string"'
    # }

    # Example of a fully generated Authorization header:
    #
    # header = {
    #     'Authorization':
    #     'MAC id="cxxxxxxxxxxxxxxxxxxxxxxxxxx",
    #      ts="1xxxxxxxxxx",
    #      nonce="Ixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    #      mac="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="'
    # }

    # The rsign library returns a list. Only the second element
    # contains the formatted Authorization header required for
    # API authentication.
    #
    # During development, it may be helpful to print the returned
    # object to review its structure.
    sub_headers = headers[1]

    # Troubleshooting example:
    # print(f'api_call_type={api_call_type}, Authorization Header={sub_headers}')

    # Build the final HTTP header dictionary that will be sent
    # with the API request.
    main_header = {'Authorization': sub_headers}

    return(main_header)


####################################################################################################
###################### SAMPLE API CALL USING AUTHENTICATION HEADER #################################
####################################################################################################

def get_default_l2_profiles_filter_by_resourceTypeId(navigator_instance,resource_type):
