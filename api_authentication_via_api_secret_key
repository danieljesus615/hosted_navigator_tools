################################################BUILDING HEARDER FOR AUTHENTICATION########################################
##############################################################################################################################################

def get_api_hearder(navigator_instance,url_path,api_call_type):

	sr = rsign.SignedRequest(api_call_type, navigator_instance, url_path, '443')
	timestamp = str(int(time.time()))

	nonce = binascii.b2a_base64(os.urandom(32)).decode().strip()
	headers = sr.get_signed_header(nonce, timestamp, api_key_id, api_key_secret)

	####header = {'Authorization': 'THIS SHOULD BE A STRING DATA TYPE See sample below'}##########
	####header below shows all the variables passed into the authorization hearder ###############
	#header = {'Authorization': 'Authorization':'MAC id="string", ts="string", nonce="string", mac="string"'}
	
	######### final header should look like someting bellow#######################################
	#header = {'Authorization':'MAC id="cXXXXXXXXXXXXXXXXXXXXXXXXXXX", ts="1XXXXXXXXX", nonce="IXXXXXXXXXXXXXXXXXXXXXXXX=", mac="zXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX="'}
	
	
	###We only need the second item of the list data type#####
	### I would print this 'sub_headers' to see what the results is  we only need the second item fromt the list.
	sub_headers = headers[1]  
	
	
	#############for troubleshooting I usually print the outout to see what it looks like####
	#print(F'api_call_type  {api_call_type} get_api_hearder sub_headers: '+str(sub_headers))
	
	######puting together the header in the appropiate format which will be a json object see below #######
	main_header = {'Authorization':sub_headers}
	return(main_header)
	


	
