def get_default_l2_profiles(navigator_instance):
	url = F"https://{navigator_instance}/bpocore/market/api/v1/resources?resourceTypeId=ifd.v6.resourceTypes.ServiceFacadeProfile"
	url_path = '/bpocore/market/api/v1/resources?resourceTypeId=ifd.v6.resourceTypes.ServiceFacadeProfile'
	payload = ""
	api_call_type = 'GET'  
	authentication_header = get_api_hearder(navigator_instance,url_path,api_call_type)  ####<<<<<< HERE YOU REFERENCE THE HEADER WITH THE FUCNTION ABOVE #######
	
	#######before you send the api call add a couple more things to the header##########
	authentication_header['Content-Type'] = 'application/json'
	authentication_header['Accept'] = 'application/json'
	#it should look like this  see below before you send the api call
	#authentication_header = {'Authorization':'MAC id="c7a86b382c4884fb5d4d4cf13cfddca14e918955", ts="1787055444", nonce="IYusPFx/+HBiO8Cie0KdOSL2PQg21XAjlyIRpol8vyk=", mac="zdVhrWI7mw6UY/911TpvD97iaILBhZSRuhQrHQsQ2Io="','Content-Type':'application/json','Accept':'application/json'}
	response = requests.request(api_call_type, url, headers=authentication_header, data=payload,verify = False)
	
	####show the text response########
	#print(response.text)
	get_default_l2_profiles_json = json.loads(response.text)
	get_default_l2_profiles_info_list = get_default_l2_profiles_json['items']
	
	####show the text response but in json format########
	print(json.dumps(get_default_l2_profiles_info_list, indent=4))
	
	return(get_default_l2_profiles_info_list)
	
	


get_default_l2_profiles_info_list  = get_default_l2_profiles(navigator_instance)
